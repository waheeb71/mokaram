# Application Server Port
PORT=3000

# Canonical Public App URL (Used for sitemap and links)
APP_URL="http://localhost:3000"

# Neon PostgreSQL Database Connection String
DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require"

# Cloudflare R2 Storage (S3-Compatible)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="your_bucket_name"
R2_PUBLIC_URL="https://pub-your_public_id.r2.dev"

# Admin Master Password Default
ADMIN_DEFAULT_PASSWORD="your_admin_password"

# Unguessable Secret Admin Route (Change to your desired unguessable slug)
VITE_ADMIN_SECRET_PATH="/your-unguessable-secret-path"

# Telegram Bot Instant Notifications for New Quote Requests
# 1. Open Telegram, search for @BotFather, type /newbot, follow steps to get token
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# 2. Get your Chat ID by messaging @userinfobot or @raw_data_bot on Telegram
TELEGRAM_CHAT_ID="123456789"

# Website Analytics (Google Analytics 4 / Cloudflare Web Analytics)
# Optional: Set your GA4 Measurement ID (e.g., G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
